import pandas as pd
import numpy as np
import os
import glob

def calRSI(data, window=14):
    delta = data.diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=window).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=window).mean()
    rs = gain / loss
    return 100 - (100 / (1 + rs))


def backTestStrat(filePath):
    
    df = pd.read_csv(filePath, skiprows=[1])
    df['Date'] = pd.to_datetime(df['Date'])
    df = df.sort_values('Date').reset_index(drop=True)
    
    # indicaters
    df['SMA50'] = df['Close'].rolling(window=50).mean()
    df['SMA200'] = df['Close'].rolling(window=200).mean()
    df['RSI'] = calRSI(df['Close'], window=14)
    df['VolAvg'] = df['Volume'].rolling(window=20).mean()
    
    # Generate Signal
    # 0: Hold, 1: Buy, -1: Sell
    df['Signal'] = 0 
    
    # Buy: SMA50 > SMA200 AND RSI < 30 AND Volume above average
    buyCond = (df['SMA50'] > df['SMA200']) & (df['RSI'] < 30) & (df['Volume'] > df['VolAvg'])
    df.loc[buyCond, 'Signal'] = 1
    
    # Sell when: RSI > 70 AND Price below SMA50
    sellCond = (df['RSI'] > 70) & (df['Close'] < df['SMA50'])
    df.loc[sellCond, 'Signal'] = -1
    
    # Simulate Trades
    trades = []
    poss = 0
    entryCost = 0
    entryDate = None
    
    for i, row in df.iterrows():
        
        # simple state machine
        if poss == 0 and row['Signal'] == 1:
            poss = 1
            entryCost = row['Close']
            entryDate = row['Date']
            
        elif poss == 1 and row['Signal'] == -1:
            poss = 0
            exitCost = row['Close']
            exitDate = row['Date']
            pctReturn = (exitCost - entryCost) / entryCost
            trades.append({
                'Entry Date': entryDate,
                'Entry Price': entryCost,
                'Exit Date': exitDate,
                'Exit Price': exitCost,
                'Return (%)': pctReturn * 100
            })
            
    tradesDF = pd.DataFrame(trades)
    
    # Calculate Metrics
    if len(tradesDF) > 0:
        totTrades = len(tradesDF)
        totReturn = tradesDF['Return (%)'].sum()
        winRate = (tradesDF['Return (%)'] > 0).mean() * 100
        
        sumReturns = (1 + tradesDF['Return (%)'] / 100).cumprod()
        peak = sumReturns.cummax()
        drawDown = (sumReturns - peak) / peak
        maxDrawDown = drawDown.min() * 100 if len(drawDown) > 0 else 0
        
        sharpe = (tradesDF['Return (%)'].mean() / tradesDF['Return (%)'].std()) if tradesDF['Return (%)'].std() != 0 else 0
        
    else:
        totTrades = 0
        totReturn = 0
        winRate = 0
        maxDrawDown = 0
        sharpe = 0
        
    mets = {
        'Total # of Trades': totTrades,
        'Total Return (%)': totReturn,
        'Sharpe Ratio': sharpe,
        'Maximum Drawdown (%)': maxDrawDown,
        'Win Rate (%)': winRate
    }
    
    return tradesDF, mets

def processFol(folPath, splitName):
    print(f"\n ============== Working {splitName} Data ================ ")
    files = glob.glob(os.path.join(folPath, '*.csv'))
    
    for file in files:
        stockName = os.path.basename(file).split('.')[0]
        tradesDF, mets = backTestStrat(file)
        
        print(f"\nStock: {stockName}")
        for k, v in mets.items():
            print(f"{k}: {v:.2f}" if isinstance(v, float) else f"{k}: {v}")
            
        if len(tradesDF) > 0:
            outTrainFile = f"{stockName}.csv"
            tradesDF.to_csv(outTrainFile, index=False)
            print(f"Saved trades to {outTrainFile}")


if __name__ == "__main__":
    baseDir = "Data-Split"
    trainDir = os.path.join(baseDir, "Train")
    testDir = os.path.join(baseDir, "Test")
    
    if os.path.exists(trainDir):
        processFol(trainDir, "Train (10 Years)")
        
    if os.path.exists(testDir):
        processFol(testDir, "Test (5 Years)")
